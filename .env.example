# Copie para `.env` (na raiz do repositório) e preencha com as credenciais
# OAuth2 do tipo "Desktop app" criadas no Google Cloud Console (veja o README).
# O arquivo é lido em build-time pelo src-tauri/build.rs; variáveis definidas
# no shell têm precedência sobre este arquivo. NUNCA commite o `.env`.

RETROSYNC_GOOGLE_CLIENT_ID=

# Produção: use o proxy Cloudflare Worker (client_secret nunca entra no binário).
# RETROSYNC_TOKEN_PROXY_URL=https://retrosync-auth.<usuario>.workers.dev
# RETROSYNC_PROXY_SECRET=        # mesmo valor configurado em: wrangler secret put PROXY_SECRET

# Desenvolvimento local (sem Worker): preencha o client_secret diretamente.
# RETROSYNC_GOOGLE_CLIENT_SECRET=
